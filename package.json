{
  "name": "dotnet-wasm-bundler-root",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "build:plugin": "pnpm --filter unplugin-dotnet-wasm build",
    "build:plugin:fixture": "pnpm --filter unplugin-dotnet-wasm build:fixture",
    "test:unit": "pnpm --filter unplugin-dotnet-wasm test",
    "test:e2e": "pnpm --filter @dotnet-wasm-bundler/e2e test:e2e",

    "build:sample:vite-wasm": "dotnet build samples/libraries/WasmLibrary/WasmLibrary.csproj -c Debug && pnpm --filter @dotnet-wasm-bundler/vite-vanilla-wasm build",
    "dev:sample:vite-wasm": "pnpm --filter @dotnet-wasm-bundler/vite-vanilla-wasm dev",
    "preview:sample:vite-wasm": "pnpm build:sample:vite-wasm && pnpm --filter @dotnet-wasm-bundler/vite-vanilla-wasm preview",

    "build:sample:vite-blazor": "dotnet build samples/libraries/BlazorElements/BlazorElements.csproj -c Debug && pnpm --filter @dotnet-wasm-bundler/vite-vanilla-blazor build",
    "dev:sample:vite-blazor": "pnpm --filter @dotnet-wasm-bundler/vite-vanilla-blazor dev",
    "preview:sample:vite-blazor": "pnpm --filter @dotnet-wasm-bundler/vite-vanilla-blazor preview",

    "build:sample:webpack-blazor": "dotnet build samples/libraries/BlazorApp/BlazorApp.csproj -c Debug && pnpm --filter @dotnet-wasm-bundler/webpack-vanilla-blazor build",
    "dev:sample:webpack-blazor": "pnpm --filter @dotnet-wasm-bundler/webpack-vanilla-blazor dev",
    "preview:sample:webpack-blazor": "pnpm --filter @dotnet-wasm-bundler/webpack-vanilla-blazor preview",

    "build:sample:rsbuild-react": "dotnet build samples/libraries/BlazorElements/BlazorElements.csproj -c Debug && pnpm --filter @dotnet-wasm-bundler/rsbuild-react-blazor build",
    "dev:sample:rsbuild-react": "pnpm --filter @dotnet-wasm-bundler/rsbuild-react-blazor dev",
    "preview:sample:rsbuild-react": "pnpm --filter @dotnet-wasm-bundler/rsbuild-react-blazor preview",

    "build:sample:farm-vue": "dotnet build samples/libraries/WasmLibrary/WasmLibrary.csproj -c Debug && pnpm --filter @dotnet-wasm-bundler/farm-vue-wasm build",
    "dev:sample:farm-vue": "pnpm --filter @dotnet-wasm-bundler/farm-vue-wasm dev",
    "preview:sample:farm-vue": "pnpm --filter @dotnet-wasm-bundler/farm-vue-wasm preview",

    "start:sample:esbuild-node": "pnpm --filter @dotnet-wasm-bundler/esbuild-node-wasm start",
    "build:sample:esbuild-node": "dotnet build samples/libraries/WasmLibrary/WasmLibrary.csproj -c Debug && pnpm --filter @dotnet-wasm-bundler/esbuild-node-wasm build",

    "typecheck": "pnpm -r typecheck",
    "lint": "eslint",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "clean": "pnpm -r clean"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0"
  }
}
