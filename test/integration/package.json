{
  "name": "@dotnet-wasm-bundler/integration-tests",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:node": "vitest run --config vitest.e2e.config.ts",
    "test:e2e:browser": "playwright test",
    "e2e:install": "playwright install chromium --with-deps",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf coverage test-results"
  },
  "devDependencies": {
    "@farmfe/core": "^1.7.0",
    "@playwright/test": "^1.62.1",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rsbuild/core": "^2.1.10",
    "@rspack/core": "^2.1.8",
    "esbuild": "^0.28.1",
    "rimraf": "^6.0.0",
    "rolldown": "^1.2.3",
    "rollup": "^4.62.4",
    "rollup-plugin-esbuild": "^6.0.0",
    "sirv-cli": "^3.0.0",
    "ts-loader": "^9.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "webpack": "^5.109.2"
  },
  "dependencies": {
    "unplugin-dotnet-wasm": "workspace:*"
  }
}
