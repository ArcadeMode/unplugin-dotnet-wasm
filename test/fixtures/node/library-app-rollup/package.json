{
  "name": "@dotnet-wasm-bundler/library-app-node-rollup-fixture",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "node rollup.debug.mjs",
    "build:debug": "node rollup.debug.mjs",
    "build:release": "node rollup.release.mjs",
    "watch:debug": "node rollup.watch.mjs",
    "watch:release": "node rollup.watch.mjs release",
    "preview": "node --watch dist/entry.js",
    "watch:preview:debug": "npm run build:debug && concurrently -k -n watch,run \"npm:watch:debug\" \"npm:preview\"",
    "watch:preview:release": "npm run build:release && concurrently -k -n watch,run \"npm:watch:release\" \"npm:preview\"",
    "test": "node dist/entry.js",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "esbuild": "^0.24.0",
    "rimraf": "^6.0.0",
    "rollup": "^4.28.0",
    "rollup-plugin-esbuild": "^6.0.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "unplugin-dotnet-wasm": "workspace:*"
  }
}
