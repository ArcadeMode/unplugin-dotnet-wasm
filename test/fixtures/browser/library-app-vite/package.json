{
  "name": "@dotnet-wasm-bundler/library-app-browser-vite-fixture",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "vite build --mode development",
    "build:debug": "vite build --mode development",
    "build:release": "vite build --mode production",
    "watch:debug": "vite build --watch --mode development",
    "watch:release": "vite build --watch --mode production",
    "watch:preview:debug": "npm run build:debug && concurrently -k -n watch,preview \"npm:watch:debug\" \"npm:preview\"",
    "watch:preview:release": "npm run build:release && concurrently -k -n watch,preview \"npm:watch:release\" \"npm:preview\"",
    "dev": "vite --port 5174 --strictPort",
    "dev:release": "vite --port 5174 --strictPort --mode production",
    "preview": "vite preview --open",
    "test": "echo \"No tests in fixture - build-only package\" && exit 0",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "rimraf": "^6.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "unplugin-dotnet-wasm": "workspace:*"
  }
}
