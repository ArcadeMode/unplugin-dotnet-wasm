{
  "name": "@dotnet-wasm-bundler/library-app-browser-rsbuild-fixture",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "rsbuild build --env-mode development",
    "build:debug": "rsbuild build --env-mode development",
    "build:release": "rsbuild build --env-mode production",
    "watch:debug": "rsbuild build --watch --env-mode development",
    "watch:release": "rsbuild build --watch --env-mode production",
    "watch:preview:debug": "npm run build:debug && concurrently -k -n watch,preview \"npm:watch:debug\" \"npm:preview\"",
    "watch:preview:release": "npm run build:release && concurrently -k -n watch,preview \"npm:watch:release\" \"npm:preview\"",
    "dev": "rsbuild dev",
    "dev:release": "rsbuild dev --env-mode production",
    "preview": "rsbuild preview",
    "test": "echo \"No tests in fixture - build-only package\" && exit 0",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@rsbuild/core": "^2.1.10",
    "concurrently": "^10.0.4",
    "rimraf": "^6.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "unplugin-dotnet-wasm": "workspace:*"
  }
}
