{
  "name": "@dotnet-wasm-bundler/library-app-browser-rolldown-fixture",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "rolldown -c rolldown.config.mjs --environment BUILD:development",
    "build:debug": "rolldown -c rolldown.config.mjs --environment BUILD:development",
    "build:release": "rolldown -c rolldown.config.mjs --environment BUILD:production",
    "watch:debug": "rolldown -c rolldown.config.mjs --watch --environment BUILD:development",
    "watch:release": "rolldown -c rolldown.config.mjs --watch --environment BUILD:production",
    "watch:preview:debug": "npm run build:debug && concurrently -k -n watch,preview \"npm:watch:debug\" \"npm:preview\"",
    "watch:preview:release": "npm run build:release && concurrently -k -n watch,preview \"npm:watch:release\" \"npm:preview\"",
    "preview": "npx serve dist",
    "test": "echo \"No tests in fixture - build-only package\" && exit 0",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "rimraf": "^6.0.0",
    "rolldown": "^1.1.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "unplugin-dotnet-wasm": "workspace:*"
  }
}
