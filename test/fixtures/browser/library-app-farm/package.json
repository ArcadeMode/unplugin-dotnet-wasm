{
  "name": "@dotnet-wasm-bundler/library-app-browser-farm-fixture",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "farm build --mode development",
    "build:debug": "farm build --mode development",
    "build:release": "cross-env DOTNET_RELEASE=1 farm build --mode production",
    "watch:debug": "farm build --watch --mode development",
    "watch:release": "cross-env DOTNET_RELEASE=1 farm build --watch --mode production",
    "watch:preview:debug": "npm run build:debug && concurrently -k -n watch,preview \"npm:watch:debug\" \"npm:preview\"",
    "watch:preview:release": "npm run build:release && concurrently -k -n watch,preview \"npm:watch:release\" \"npm:preview\"",
    "dev": "farm dev --port 5174",
    "dev:release": "cross-env DOTNET_RELEASE=1 farm dev --port 5174",
    "preview": "npx serve dist",
    "test": "echo \"No tests in fixture - build-only package\" && exit 0",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@farmfe/cli": "^1.0.5",
    "@farmfe/core": "^1.7.0",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "unplugin-dotnet-wasm": "workspace:*"
  }
}
