    "@tailwindcss/postcss": "^4.2.2",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "cross-env": "^10.1.0",
    "postcss": "^8.5.6",
    "react-refresh": "^0.18.0",
    "rimraf": "^6.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3"
