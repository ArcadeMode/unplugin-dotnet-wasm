    "clean": "rimraf dist"
  },
  "dependencies": {
    "unplugin-dotnet-wasm": "workspace:*",
    "vue": "^3.5.21"
  },
  "devDependencies": {
    "@farmfe/cli": "^1.0.5",
    "@farmfe/core": "^1.7.0",
    "@farmfe/js-plugin-postcss": "^1.12.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@vitejs/plugin-vue": "5.1.4",
    "cross-env": "^10.1.0",
    "postcss": "^8.5.6",
    "rimraf": "^6.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^5.4.19",
    "vue-tsc": "^3.0.8"
  }
}
