{
  "name": "@dotnet-wasm-bundler/farm-vue-wasm",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "farm start",
    "build": "farm build --mode development",
    "build:release": "cross-env DOTNET_RELEASE=1 farm build --mode production",
